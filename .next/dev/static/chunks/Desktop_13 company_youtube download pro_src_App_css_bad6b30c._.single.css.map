/* Modern Dark Blue Theme for YouTube Download Pro */

:root {
    --primary-blue: #000000;
    --dark-blue: #1a1a1a;
    --light-blue: #6a6a6a;
    --bg-dark: #ffffff;
    --bg-dark-secondary: #f2f2f2;
    --bg-card: #e6e6e6;
    --text-primary: #000000;
    --text-secondary: #555555;
    --accent-gradient: linear-gradient(135deg, #000 0%, #555 100%);
    --shadow-glow: 0 0 25px rgba(0, 0, 0, 0.15);
    --shadow-card: 0 10px 35px rgba(0, 0, 0, 0.15);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: radial-gradient(circle at 20% 50%, rgba(0, 0, 0, 0.05) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(0, 0, 0, 0.05) 0%, transparent 50%);
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
}


/* Animated Background */

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 40%, rgba(0, 0, 0, 0.06) 0%, transparent 50%), radial-gradient(circle at 70% 70%, rgba(0, 0, 0, 0.06) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}


/* Navbar Styling */

.navbar {
    background: rgba(255, 255, 255, 0.9) !important;
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.navbar-brand h1 {
    font-size: 1.8rem;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
}

.navbar-toggler {
    border-color: var(--primary-blue) !important;
}

.navbar-toggler-icon {
    filter: brightness(0);
}


/* Header Styling */

.header {
    padding: 6rem 1rem 4rem;
    background: transparent;
    position: relative;
    z-index: 1;
}

.header-content {
    max-width: 900px;
    margin: 0 auto;
    animation: fadeInUp 0.8s ease-out;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.main-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.highlight {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    display: inline-block;
}

.type-wrap {
    height: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem 0;
}

.type-wrap span {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 600;
    color: var(--light-blue);
}

.header-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto;
}


/* Input and Button Styling */

.form-control,
.form-select {
    /* REMOVE !important here to allow inline styles in JSX to override */
    background: rgba(51, 65, 85, 0.8);
    border: 2px solid rgba(0, 0, 0, 0.2);
    color: var(--text-primary) !important;
    transition: all 0.3s ease;
}

.form-control:focus,
.form-select:focus {
    /* You may want to keep !important on focus states or remove them too */
    background: rgba(0, 0, 0, 0.15) !important;
    border-color: var(--primary-blue) !important;
    box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25), var(--shadow-glow) !important;
    color: var(--text-primary) !important;
}

.form-control::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
}

.form-select option {
    background: var(--bg-dark-secondary);
    color: var(--text-primary);
}


/* Download Button */

button.btn {
    background: linear-gradient(135deg, #000000 0%, #444444 100%) !important;
    border: none !important;
    color: white !important;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

button.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
}

button.btn:hover::before {
    left: 100%;
}

button.btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
}

button.btn:active {
    transform: translateY(0);
}


/* Card Styling */

.card {
    background: rgba(230, 230, 230, 0.8) !important;
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    border-radius: 20px !important;
    backdrop-filter: blur(20px);
    transition: all 0.3s ease;
    box-shadow: var(--shadow-card);
}

.card:hover {
    transform: translateY(-5px);
    border-color: #000 !important;
    box-shadow: 0 15px 50px rgba(255, 255, 255, 0.1);
}

.card-body {
    padding: 2rem !important;
}

.card-title {
    color: var(--text-primary) !important;
    font-weight: 700;
}

.card-text {
    color: var(--text-secondary) !important;
}

.list-group-item {
    background: rgba(30, 41, 59, 0.5) !important;
    border-color: rgba(59, 130, 246, 0.2) !important;
    color: var(--text-primary) !important;
    transition: background 0.3s ease;
}

.list-group-item:hover {
    background: rgba(30, 41, 59, 0.8) !important;
}

.list-group-item h4,
.list-group-item h5 {
    color: var(--text-primary) !important;
}


/* Image Styling */

.img-fluid,
.img-thumbnail {
    border-radius: 15px;
    border: 2px solid rgba(0, 0, 0, 0.2) !important;
    background: var(--bg-dark-secondary) !important;
}


/* Loading Spinner */

.spinner-border {
    color: var(--primary-blue) !important;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}


/* Result Section */

h2 {
    color: var(--text-primary);
    font-weight: 700;
    text-shadow: 0 2px 10px rgba(59, 130, 246, 0.3);
}


/* Tutorial Section */

#tutorial {
    background: transparent;
    padding: 4rem 0;
}

#tutorial h1 {
    color: var(--text-primary);
    text-shadow: 0 2px 15px rgba(59, 130, 246, 0.4);
}

#tutorial .container {
    background: rgba(30, 41, 59, 0.6) !important;
    backdrop-filter: blur(20px);
    border-radius: 25px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: var(--shadow-card);
}

#tutorial h3 {
    color: var(--light-blue);
    font-weight: 700;
    margin-bottom: 1rem;
}

#tutorial p {
    color: var(--text-secondary);
    line-height: 1.8;
}

#tutorial a {
    color: var(--primary-blue);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
}

#tutorial a:hover {
    color: var(--light-blue);
    text-decoration: underline;
}


/* Benefit Section */

#benefit {
    padding: 4rem 0;
}

#benefit h1 {
    color: var(--text-primary);
    text-shadow: 0 2px 15px rgba(59, 130, 246, 0.4);
}

.card-hover {
    background: rgba(230, 230, 230, 0.8) !important;
    border: 1px solid rgba(0, 0, 0, 0.2) !important;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
}

.card-hover:hover {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.20);
    border-color: #000 !important;
}

::placeholder {
    color: rgb(56, 56, 56) !important;
    opacity: 0.7;
    /* biar sedikit transparan */
}

.card-hover img {
    filter: brightness(0) saturate(100%) invert(56%) sepia(94%) saturate(1815%) hue-rotate(201deg) brightness(103%) contrast(92%);
    transition: transform 0.3s ease;
}

.card-hover:hover img {
    transform: scale(1.1) rotate(5deg);
}


/* Footer */

footer {
    background: rgba(255, 255, 255, 0.95) !important;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

footer h4,
footer h5 {
    color: var(--text-primary);
}

footer a {
    color: var(--primary-blue);
    text-decoration: none;
    transition: color 0.3s ease;
}

footer a:hover {
    color: var(--light-blue);
}

footer img {
    transition: transform 0.3s ease, filter 0.3s ease;
    filter: brightness(0) saturate(100%) invert(56%) sepia(94%) saturate(1815%) hue-rotate(201deg) brightness(103%) contrast(92%);
}

footer img:hover {
    transform: scale(1.2);
    filter: brightness(0) saturate(100%) invert(76%) sepia(58%) saturate(1815%) hue-rotate(201deg) brightness(103%) contrast(92%);
}


/* Error and Success Messages */

.text-danger {
    color: #ef4444 !important;
    font-weight: 500;
}

.text-muted {
    color: var(--text-secondary) !important;
}


/* Responsive Design */

@media (max-width: 768px) {
    .header {
        padding: 5rem 1rem 3rem;
    }
    .main-title {
        font-size: 2rem;
    }
    .card {
        margin: 1rem 0;
    }
    #tutorial .container {
        padding: 2rem 1rem !important;
    }
}


/* Smooth Scrolling */

html {
    scroll-behavior: smooth;
}


/* Selection Color */

::selection {
    background: #000000;
    color: #fff;
}

::-moz-selection {
    background: var(--primary-blue);
    color: white;
}


/* Scrollbar Styling */

::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: var(--bg-dark);
}

::-webkit-scrollbar-thumb {
    background: #000000;
}

::-webkit-scrollbar-thumb:hover {
    background: #444444;
}


/* Button Primary Override */

.btn-primary {
    background: var(--accent-gradient) !important;
    border: none !important;
}

.btn-primary:hover {
    box-shadow: 0 10px 25px rgba(59, 130, 246, 0.4) !important;
}


/* Offcanvas Styling */

.offcanvas {
    background: rgba(15, 23, 42, 0.98) !important;
    backdrop-filter: blur(20px);
    border-left: 1px solid rgba(59, 130, 246, 0.2) !important;
}

.offcanvas-header {
    border-bottom-color: rgba(59, 130, 246, 0.2) !important;
}

.offcanvas-title {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.btn-close {
    filter: brightness(0) saturate(100%) invert(100%);
}


/* Animation for cards */

@keyframes cardFloat {
    0%,
    100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.card-hover {
    animation: cardFloat 6s ease-in-out infinite;
}

.card-hover:nth-child(2) {
    animation-delay: 2s;
}

.card-hover:nth-child(3) {
    animation-delay: 4s;
}