// src/app/robots.js
export default function robots() {
  return {
    rules: [
      {
        userAgent: "*",
        allow: "/",
        disallow: ["/api/", "/_next/", "/admin/"],
      },
    ],
    sitemap: "https://youtubedownloadpro.com/sitemap.xml",
    host: "https://youtubedownloadpro.com",
  };
}